# =============================================================================
# FASHLINK — variables d'environnement
# Copier en `.env.local` pour le developpement, renseigner dans Vercel en prod.
# =============================================================================

# --- Base de donnees ---------------------------------------------------------
# PostgreSQL (Supabase, Neon, Railway ou instance auto-heberge).
DATABASE_URL="postgresql://fashlink:fashlink@localhost:5432/fashlink?schema=public"
# Supabase uniquement : connexion directe pour les migrations (hors pooler).
# DIRECT_URL="postgresql://postgres:motdepasse@db.xxx.supabase.co:5432/postgres"

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FASHLINK"

# --- Authentification --------------------------------------------------------
# Secret de signature des JWT. Generer avec : openssl rand -base64 48
JWT_SECRET="remplacer-par-un-secret-de-48-octets-minimum-genere-aleatoirement"
JWT_ACCESS_TTL="900"          # 15 minutes, en secondes
JWT_REFRESH_TTL="2592000"     # 30 jours, en secondes

# --- Medias (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Preset non signe pour l'upload direct navigateur -> Cloudinary.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="fashlink_portfolio"

# --- Paiement : CinetPay -----------------------------------------------------
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""        # sert au calcul du HMAC x-token du webhook
CINETPAY_BASE_URL="https://api-checkout.cinetpay.com/v2"

# --- Paiement : Wave ---------------------------------------------------------
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""        # signature Wave-Signature (HMAC-SHA256)
WAVE_BASE_URL="https://api.wave.com/v1"

# --- Paiement : MTN Mobile Money ---------------------------------------------
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="mtnbenin"
MTN_MOMO_BASE_URL="https://proxy.momoapi.mtn.com"
MTN_MOMO_WEBHOOK_SECRET=""

# --- Emails transactionnels --------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="FASHLINK <no-reply@fashlink.africa>"

# --- Taches planifiees -------------------------------------------------------
# Protege /api/cron/* : Vercel Cron envoie `Authorization: Bearer <secret>`.
CRON_SECRET=""
